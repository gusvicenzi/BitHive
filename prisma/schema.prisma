generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model Device {
  id          String   @id @default(cuid())
  address     String   @unique
  name        String
  demo        Boolean  @default(false)
  snapshot    String   @default("{}")
  lastSeen    DateTime?
  failures    Int      @default(0)
  nextPoll    DateTime @default(now())
  createdAt   DateTime @default(now())
  metrics     Metric[]
  events      Event[]
  changes     ConfigChange[]
  profiles    Profile[]
  tuningRuns  TuningRun[]
  @@index([nextPoll])
}
model Profile {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name        String
  settings    String
  createdAt   DateTime @default(now())
  @@index([deviceId, createdAt])
}
model PoolProfile {
  id          String   @id @default(cuid())
  name        String   @unique
  settings    String
  createdAt   DateTime @default(now())
}
model Metric {
  id          Int      @id @default(autoincrement())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
  hashRate    Float?
  power       Float?
  temp        Float?
  vrTemp      Float?
  errorRate   Float?
  accepted    Float?
  rejected    Float?
  @@index([deviceId, timestamp])
  @@index([timestamp])
}
model Event {
  id          Int      @id @default(autoincrement())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
  kind        String
  @@index([deviceId, timestamp])
  @@index([timestamp])
}
model ConfigChange {
  id          Int      @id @default(autoincrement())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
  before      String
  requested   String
  after       String?
  result      String
  @@index([deviceId, timestamp])
  @@index([timestamp])
}

model TuningRun {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestKey  String
  activeSlot  Int?     @unique
  config      String
  state       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attempts    TuningAttempt[]
  checkpoints TuningCheckpoint[]
  @@unique([deviceId, requestKey])
  @@index([deviceId, createdAt])
}
model TuningAttempt {
  id          String   @id @default(cuid())
  runId       String
  run         TuningRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind        String
  profile     String
  candidateId String?
  outcome     String   @default("pending")
  reason      String?
  summary     String?
  auditId     Int?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  samples     TuningSample[]
  @@index([runId, startedAt])
}
model TuningSample {
  id          Int      @id @default(autoincrement())
  attemptId   String
  attempt     TuningAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  timestamp   DateTime
  phase       String
  data        String
  @@index([attemptId, timestamp])
}
model TuningCheckpoint {
  id          Int      @id @default(autoincrement())
  runId       String
  run         TuningRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
  profile     String
  purpose     String
  status      String
  auditId     Int?
  @@index([runId, timestamp])
}
