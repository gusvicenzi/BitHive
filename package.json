{
  "name": "bithive",
  "version": "0.1.0",
  "private": true,
  "description": "Local, capability-aware Bitaxe fleet management",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/manage.mjs generate",
    "start": "node scripts/manage.mjs start",
    "dev": "node scripts/manage.mjs dev",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/manage.mjs migrate",
    "db:dev": "node scripts/manage.mjs schema",
    "check:translations": "node scripts/check-translations.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.7",
    "i18next": "^25.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^16.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "jsdom": "^27.1.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
